---
export interface Props { title: string; description: string; href: string; image?: string; category?: string; pubDate: Date; readingTime?: number; variant?: 'feature' | 'standard'; index?: number; }
const { title, description, href, image, category, pubDate, variant = 'standard', index = 0 } = Astro.props;
const dateline = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
const itemNum = String(index + 1).padStart(2, '0');
---
<article class={`group h-full ${variant === 'feature' ? 'md:col-span-2' : ''}`} data-category={category || ''} data-title={title.toLowerCase()} data-date={pubDate.toISOString()}>
  <a href={href} class="clinical-card flex h-full flex-col overflow-hidden rounded-xl p-4 focus-visible:outline-ring sm:p-5">
    <div class="mb-4 flex items-center justify-between gap-3 text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground"><span>№ {itemNum}</span>{category && <span class="rounded-full bg-primary/8 px-2 py-1 text-primary">{category}</span>}</div>
    {image && <div class={`${variant === 'feature' ? 'aspect-[16/9]' : 'aspect-[4/3]'} mb-5 overflow-hidden rounded-lg bg-muted ring-1 ring-border/50`}><img src={image} alt={title} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" /></div>}
    <span class="verified-badge mb-4 self-start">Expert Verified</span>
    <h3 class={`${variant === 'feature' ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl'} mb-3 font-extrabold leading-[1.12] tracking-[-0.02em] text-primary transition-colors group-hover:text-accent`} style="font-family: var(--font-display);">{title}</h3>
    <p class="mb-5 line-clamp-3 text-[15px] leading-relaxed text-muted-foreground">{description}</p>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border/70 pt-4 text-[11px] font-bold uppercase tracking-[0.16em] text-muted-foreground"><time datetime={pubDate.toISOString()}>{dateline}</time><span class="inline-flex min-h-9 items-center gap-2 rounded-full bg-accent/10 px-3 text-accent transition-colors group-hover:bg-accent group-hover:text-accent-foreground">Read →</span></div>
  </a>
</article>
