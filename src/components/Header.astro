---
import ThemeToggle from './ThemeToggle.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'BodyWise Lab';
const edition = import.meta.env.PUBLIC_SITE_EDITION || 'Clinical Integrity';
const displayName = siteName.replace(/bodywiselab/i, 'BodyWise Lab');
const navItems = [
  { label: 'Fitness', href: '/category/fitness/' },
  { label: 'Health', href: '/category/health/' },
  { label: 'Nutrition', href: '/category/nutrition/' },
  { label: 'Supplements', href: '/category/supplements/' },
  { label: 'Ergonomics', href: '/category/ergonomics/' },
  { label: 'Library', href: '/posts/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Experts', href: '/experts/' },
];
---
<header class="sticky top-0 z-50 border-b border-primary/10 bg-primary text-primary-foreground shadow-md shadow-primary/10">
  <div class="clinical-container flex min-h-[76px] items-center justify-between gap-5">
    <a href="/" class="group flex min-w-0 shrink items-center gap-3 rounded-lg py-2 focus-visible:outline-ring" aria-label={`${displayName} home`}>
      <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-white text-primary shadow-sm" aria-hidden="true">
        <span class="text-xl font-extrabold" style="font-family: var(--font-display);">B</span>
        <span class="absolute -right-1 top-2 h-3 w-3 rounded-full bg-accent ring-2 ring-primary"></span>
      </span>
      <span class="hidden sm:inline truncate text-2xl font-extrabold tracking-[-0.03em] md:text-3xl" style="font-family: var(--font-display);">{displayName}</span>
    </a>
    <nav aria-label="Primary navigation" class="hidden xl:block">
      <ul class="flex items-center gap-1 text-[12px] font-bold uppercase tracking-[0.11em]">
        {navItems.map((item) => <li><a href={item.href} class="rounded-full px-3 py-2 text-primary-foreground/78 transition-colors hover:bg-white/10 hover:text-white">{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-3">
      <a href="/search/" class="hidden rounded-full bg-white/12 px-4 py-2 text-xs font-bold uppercase tracking-[0.13em] text-white ring-1 ring-white/15 transition hover:bg-white/20 sm:inline-flex">Search</a>
      <a href="/posts/" class="hidden rounded-full bg-accent px-4 py-2 text-xs font-bold uppercase tracking-[0.13em] text-accent-foreground shadow-sm transition hover:brightness-105 md:inline-flex">Subscribe</a>
      <ThemeToggle />
    </div>
  </div>
  <div class="overflow-x-hidden border-t border-white/10 bg-primary/95 xl:hidden">
    <nav aria-label="Mobile primary navigation" class="clinical-container flex gap-2 overflow-x-auto py-2 text-[11px] font-bold uppercase tracking-[0.12em] [-webkit-overflow-scrolling:touch]">
      {navItems.map((item) => <a href={item.href} class="shrink-0 rounded-full border border-white/15 bg-white/8 px-4 py-2 text-primary-foreground/82">{item.label}</a>)}
    </nav>
  </div>
  {edition && <div class="hidden border-t border-white/10 bg-primary/90 py-1 text-center text-[10px] font-bold uppercase tracking-[0.24em] text-primary-foreground/60 md:block">{edition} · evidence-based wellness intelligence</div>}
</header>
