---
export interface Props { title: string; subtitle: string; illustration?: string; ctaText?: string; ctaHref?: string; }
const envIllustration = import.meta.env.PUBLIC_HAS_HERO_ILLUSTRATION === 'true' ? '/images/illustrations/hero.png' : undefined;
const edition = import.meta.env.PUBLIC_SITE_EDITION || 'BW · LAB 01';
const tagline = import.meta.env.PUBLIC_SITE_TAGLINE || 'Evidence-based conditioning for desk workers';
const { title, subtitle, illustration = envIllustration, ctaText = 'Enter the Library', ctaHref = '/posts/' } = Astro.props;
const today = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
---
<section class="relative overflow-hidden border-b border-border/70 bg-background">
  <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true" style="background-image: linear-gradient(to right, rgb(var(--color-primary)) 1px, transparent 1px), linear-gradient(to bottom, rgb(var(--color-primary)) 1px, transparent 1px); background-size: 56px 56px;"></div>
  <div class="absolute right-[-8rem] top-[-10rem] h-[34rem] w-[34rem] rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
  <div class="clinical-container relative grid gap-10 py-14 md:grid-cols-[minmax(0,1.1fr)_minmax(320px,0.75fr)] md:items-center md:py-20 lg:py-24">
    <div>
      <div class="mb-8 flex flex-wrap items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-muted-foreground">
        <span class="rounded-full bg-accent/10 px-3 py-1 text-accent ring-1 ring-accent/20">{edition}</span><span class="h-px w-12 bg-border"></span><span>{today}</span>
      </div>
      <p class="section-kicker mb-4">Expert Verified · Science Backed · Practical</p>
      <h1 class="max-w-4xl text-5xl font-extrabold leading-[1.02] tracking-[-0.04em] text-primary md:text-7xl lg:text-[5.8rem]" style="font-family: var(--font-display);">{title}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-muted-foreground md:text-2xl md:leading-9">{subtitle}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4"><a href={ctaHref} class="btn-primary">{ctaText} <span aria-hidden="true">→</span></a><a href="/compare/" class="btn-secondary">Compare supplements</a><span class="verified-badge">Expert Verified</span></div>
      <div class="mt-10 grid max-w-2xl grid-cols-3 gap-3 text-center sm:text-left"><div class="clinical-card p-4"><strong class="block text-2xl text-primary">8+</strong><span class="text-xs text-muted-foreground">sources per guide</span></div><div class="clinical-card p-4"><strong class="block text-2xl text-primary">1–10</strong><span class="text-xs text-muted-foreground">safety scoring</span></div><div class="clinical-card p-4"><strong class="block text-2xl text-primary">0</strong><span class="text-xs text-muted-foreground">medical hype</span></div></div>
    </div>
    <div class="relative"><div class="absolute inset-4 rounded-[2rem] bg-primary/8 rotate-2" aria-hidden="true"></div><div class="clinical-card relative overflow-hidden rounded-[2rem] p-5">{illustration ? <img src={illustration} alt="" class="h-[22rem] w-full rounded-2xl object-cover md:h-[30rem]" loading="eager" /> : <div class="grid h-[26rem] place-items-center rounded-2xl bg-muted"><span class="text-8xl font-extrabold text-primary/35">B</span></div>}<div class="mt-5 rounded-2xl bg-primary p-5 text-primary-foreground"><p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary-foreground/65">Clinical note</p><p class="mt-2 text-lg font-bold">{tagline}</p><p class="mt-2 text-sm text-primary-foreground/75">Every public article keeps source counts, visuals, and transparent editorial-review metadata visible.</p></div></div></div>
  </div>
</section>
