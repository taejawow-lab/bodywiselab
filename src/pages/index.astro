---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
const posts = (await getCollection('posts')).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = posts.slice(0, 3); const recentPosts = posts.slice(3, 12);
const categories = Array.from(new Set(posts.map((p) => p.data.category).filter(Boolean))).slice(0, 8);
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION || '';
const heroTitle = import.meta.env.PUBLIC_SITE_HERO_TITLE || 'Evidence-Based Conditioning for Desk Workers';
const heroSubtitle = import.meta.env.PUBLIC_SITE_HERO_SUBTITLE || siteDescription;
---
<BaseLayout title="Home" description={siteDescription}>
  <Hero title={heroTitle} subtitle={heroSubtitle} />
  <section class="clinical-container py-16 md:py-24"><div class="grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:items-end"><div><p class="section-kicker">Trending Topics</p><h2 class="section-title mt-3">Clinical signal, not wellness noise</h2></div><p class="text-lg leading-8 text-muted-foreground">BodyWise Lab turns primary sources, safety caveats, and practical routines into readable guides for exercise, sleep, recovery, supplements, and desk-worker health.</p></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{categories.map((category) => <a href={`/category/${category.toLowerCase().trim().replace(/\s+/g, '-')}/`} class="clinical-card p-5"><span class="verified-badge">Reviewed</span><h3 class="mt-5 text-2xl font-extrabold text-primary">{category}</h3><p class="mt-2 text-sm text-muted-foreground">Browse evidence-grounded guides and safety notes.</p></a>)}</div></section>
  {featuredPosts.length > 0 && <section class="clinical-container py-12 md:py-20"><div class="mb-12 grid gap-6 md:grid-cols-[0.85fr_1.15fr] md:items-end"><div><p class="section-kicker">Featured Library</p><h2 class="section-title mt-3">Expert-verified field notes</h2></div><div><p class="text-lg leading-8 text-muted-foreground">Hand-picked stories grounded in cited research, practical constraints, and transparent review metadata.</p><a href="/posts/" class="btn-secondary mt-5">View archive →</a></div></div><div class="grid grid-cols-12 gap-6 md:gap-8">{featuredPosts[0] && <div class="col-span-12 md:col-span-7"><ArticleCard title={featuredPosts[0].data.title} description={featuredPosts[0].data.description} href={`/posts/${featuredPosts[0].slug}/`} image={featuredPosts[0].data.heroImage} category={featuredPosts[0].data.category} pubDate={featuredPosts[0].data.pubDate} variant="feature" index={0}/></div>}{featuredPosts.slice(1).map((post, i) => <div class="col-span-12 md:col-span-5"><ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}/`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} index={i+1}/></div>)}</div></section>}
  <section class="clinical-container py-12 md:py-20"><div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end"><div><p class="section-kicker">Research Systems</p><h2 class="section-title mt-3">Tools for safer decisions</h2></div><a href="/compare/" class="btn-primary self-start md:self-auto">Open comparison tool</a></div><div class="grid gap-5 md:grid-cols-3"><div class="clinical-card p-6"><h3 class="text-2xl font-extrabold text-primary">Supplement scores</h3><p class="mt-3 text-muted-foreground">Side-by-side safety and efficacy bars with no miracle-cure claims.</p></div><div class="clinical-card p-6"><h3 class="text-2xl font-extrabold text-primary">Knowledge library</h3><p class="mt-3 text-muted-foreground">Filter by category and sort by freshness for high-intent browsing.</p></div><div class="clinical-card p-6"><h3 class="text-2xl font-extrabold text-primary">Review board</h3><p class="mt-3 text-muted-foreground">Transparent expert-review UI patterns for reader trust.</p></div></div></section>
  {recentPosts.length > 0 && <section id="latest" class="clinical-container py-12 md:py-20"><div class="mb-10"><p class="section-kicker">Latest Updates</p><h2 class="section-title mt-3">Newly checked articles</h2></div><div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">{recentPosts.map((post, i) => <ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}/`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} index={i+3}/>)}</div></section>}
</BaseLayout>
