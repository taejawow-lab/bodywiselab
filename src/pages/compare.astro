---
import BaseLayout from '../layouts/BaseLayout.astro';
const supplements = [
  { name: 'Creatine Monohydrate', safety: 9, efficacy: 'Strong', uses: ['strength', 'power', 'aging muscle'], note: 'Best supported for resistance-training outcomes when kidney-related medical questions are handled with a clinician.' },
  { name: 'Protein Powder', safety: 8, efficacy: 'Moderate', uses: ['protein target', 'satiety', 'recovery'], note: 'Helpful when food protein is low; check allergens, sweeteners, and total daily protein first.' },
  { name: 'Electrolyte Mix', safety: 7, efficacy: 'Situational', uses: ['heat', 'sweat loss', 'long sessions'], note: 'Most useful for heavy sweat or heat exposure; sodium loads may not fit hypertension plans.' },
  { name: 'Pre-Workout Caffeine', safety: 5, efficacy: 'Variable', uses: ['alertness', 'high intensity'], note: 'Can help performance but raises sleep, anxiety, heart-rate, and medication-interaction concerns.' },
];
---
<BaseLayout title="Supplement Comparison Tool" description="Compare supplement safety, evidence strength, and practical use cases without wellness hype.">
  <section class="clinical-container py-16 md:py-24">
    <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-end"><div><p class="section-kicker">Interactive Tool</p><h1 class="section-title mt-3">Supplement comparison lab</h1></div><p class="text-lg leading-8 text-muted-foreground">A public-safe comparison surface for supplement decisions. Scores are editorial UI examples, not medical advice; always check individual contraindications with a qualified professional.</p></div>
    <div class="mt-10 clinical-card p-5"><label class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground" for="compare-search">Add to compare</label><input id="compare-search" class="mt-3 w-full rounded-lg border border-border bg-background px-4 py-3 text-lg outline-none focus:border-accent" type="search" placeholder="Search creatine, protein, electrolytes, caffeine..." /></div>
    <div id="compare-grid" class="mt-8 grid gap-5 md:grid-cols-2">{supplements.map((item) => <article class="clinical-card supplement-card p-6" data-name={item.name.toLowerCase()}><div class="flex items-start justify-between gap-4"><div><span class="verified-badge">Evidence checked</span><h2 class="mt-4 text-2xl font-extrabold text-primary">{item.name}</h2></div><span class="rounded-full bg-primary px-3 py-1 text-sm font-bold text-primary-foreground">{item.efficacy}</span></div><div class="mt-6"><div class="mb-2 flex justify-between text-sm font-bold"><span>Safety Score</span><span>{item.safety}/10</span></div><div class="score-bar"><span style={`width:${item.safety * 10}%`}></span></div></div><div class="mt-5 flex flex-wrap gap-2">{item.uses.map((use) => <span class="rounded-full bg-muted px-3 py-1 text-xs font-semibold text-muted-foreground">{use}</span>)}</div><p class="mt-5 text-sm leading-7 text-muted-foreground">{item.note}</p></article>)}</div>
    <script is:inline>
      const input = document.getElementById('compare-search');
      const cards = Array.from(document.querySelectorAll('.supplement-card'));
      input?.addEventListener('input', () => { const q = input.value.toLowerCase().trim(); cards.forEach((card) => { card.style.display = !q || card.dataset.name.includes(q) ? '' : 'none'; }); });
    </script>
  </section>
</BaseLayout>
