---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'BodyWise Lab';
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION || 'Evidence-based recovery, sleep, and nutrition for desk workers.';
---

<BaseLayout title="About" description={`About ${siteName}`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 items-end mb-16 md:mb-20">
      <div class="col-span-12 md:col-span-8">
        <p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ About · Health and fitness evidence</p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-[-0.025em] mb-6 text-balance" style="font-family: var(--font-display);">About {siteName}</h1>
        <p class="text-lg md:text-xl text-foreground/70 max-w-2xl leading-relaxed">{siteDescription}</p>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 prose-article max-w-none">
      <div class="col-span-12 md:col-span-3 mb-8 md:mb-0"><p class="text-[10px] uppercase tracking-[0.25em] font-mono text-muted-foreground sticky top-28">¶ Editorial mission</p></div>
      <div class="col-span-12 md:col-span-8 md:col-start-5 space-y-6 text-[17px] leading-[1.7]">
        <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em]" style="font-family: var(--font-display);">What we publish</h2>
        <p>{siteName} turns public-health guidance, peer-reviewed research, and practical training constraints into readable guides for exercise, sleep, recovery, supplements, hydration, and desk-worker routines.</p>
        <p>Our goal is not to replace clinicians, coaches, or dietitians. Our goal is to help readers ask better questions, recognize red flags, and use conservative routines when general education is appropriate.</p>

        <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mt-12" style="font-family: var(--font-display);">How we add value</h2>
        <ul class="space-y-3 list-none pl-0">
          <li class="border-l-2 border-accent pl-4"><strong>Decision aids</strong> — We convert broad evidence into checklists, stop rules, and comparison tables.</li>
          <li class="border-l-2 border-accent pl-4"><strong>Safety boundaries</strong> — Health articles explain when a routine is not enough and professional care is needed.</li>
          <li class="border-l-2 border-accent pl-4"><strong>Source transparency</strong> — We link the sources behind claims and explain how they affect the practical recommendation.</li>
          <li class="border-l-2 border-accent pl-4"><strong>Commercial restraint</strong> — Product and supplement content must include skip-it-if criteria and non-commercial alternatives.</li>
        </ul>

        <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mt-12" style="font-family: var(--font-display);">Corrections and contact</h2>
        <p>If you find a factual error, stale source, or unsafe interpretation, contact us through the contact page. We re-check the cited source and update pages when needed.</p>
        <p><a href="/editorial-standards/" class="underline underline-offset-4 decoration-accent hover:text-primary">Read our editorial standards</a> · <a href="/contact/" class="underline underline-offset-4 decoration-accent hover:text-primary">Contact BodyWise Lab</a></p>
      </div>
    </div>
  </article>
</BaseLayout>
