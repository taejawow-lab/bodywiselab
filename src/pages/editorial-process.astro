---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'BodyWise Lab';
const steps = [
  { n: '01', title: 'Topic fit and reader need', body: 'We choose topics where a desk worker, home trainee, or active adult needs a practical decision aid: when to train, when to stop, what to track, or how to compare safe options.' },
  { n: '02', title: 'Primary-source collection', body: 'Each evidence guide starts with official or peer-reviewed sources such as CDC, NIH, AHA, ACSM, FDA, Cochrane, PubMed-indexed papers, public-health agencies, and manufacturer specifications when equipment is discussed.' },
  { n: '03', title: 'Evidence interpretation', body: 'We do not only list links. Drafts must explain what the source changes for a real routine, where the evidence is broad population guidance, and where individual clinical advice is still needed.' },
  { n: '04', title: 'Safety-boundary edit', body: 'Health, supplement, blood-pressure, heat, smoke, and post-illness articles are checked for red flags, stop rules, contraindication reminders, and language that could be mistaken for diagnosis or treatment.' },
  { n: '05', title: 'Commercial-bias check', body: 'Product and supplement articles must include non-commercial alternatives, skip-it-if criteria, and disclosure. We reduce purchase pressure before AdSense review and avoid thin affiliate-style pages.' },
  { n: '06', title: 'Source and route QA', body: 'Before publication we build the static site, verify important links, keep thin archive/search pages out of the sitemap when appropriate, and check that changed pages expose clear titles, descriptions, and structured data.' },
  { n: '07', title: 'Update and correction handling', body: 'When a source changes or a reader reports an error, we re-check the source, update the article, and keep visible update dates so readers can judge freshness.' },
];
---

<BaseLayout title="Editorial Process" description={`How ${siteName} produces source-checked health and fitness content`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 items-end mb-16 md:mb-24">
      <div class="col-span-12 md:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Method · Source checked</p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-[-0.025em] mb-6 text-balance" style="font-family: var(--font-display);">Editorial Process</h1>
        <p class="text-lg md:text-xl text-foreground/70 max-w-2xl leading-relaxed">{siteName} publishes health and fitness articles through a source-checking and safety-boundary workflow. This is editorial review, not individual medical care.</p>
      </div>
    </div>

    <div class="space-y-12 md:space-y-16">
      {steps.map((s) => (
        <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 pb-12 md:pb-16 border-b border-border last:border-b-0">
          <div class="col-span-12 md:col-span-3"><p class="text-7xl md:text-8xl font-bold leading-none tracking-[-0.04em] text-accent" style="font-family: var(--font-display);">{s.n}</p></div>
          <div class="col-span-12 md:col-span-9 mt-4 md:mt-2"><h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mb-4" style="font-family: var(--font-display);">{s.title}</h2><p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p></div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
